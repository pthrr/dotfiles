{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:

let
  # nixbits is a git submodule consumed as a path flake input (see
  # flake.nix); mkNodeLib hands back the plain library from default.nix.
  nixbitsLib = inputs.nixbits.lib.mkNodeLib pkgs;
in
{
  # Unmount ~/Drive (sshfs) across suspend so a dead SSH tunnel can't
  # leave FUSE I/O stuck in D-state and block the kernel's freeze pass.
  #
  # This is a root-owned script in /etc/systemd/system-sleep/, invoked
  # directly by systemd-suspend.service BEFORE the kernel freeze pass.
  # A user-scope unit tied to sleep.target does not fire on
  # `systemctl suspend` (that target only lives at system scope).
  #
  # Because home-manager runs as the user, we install the script via
  # `sudo install`; this requires a one-shot sudoers rule:
  #
  #   sudo tee /etc/sudoers.d/home-manager-sleep-hook <<'EOF'
  #   pthrr ALL=(root) NOPASSWD: /usr/bin/install -D -m0755 -o root -g root /nix/store/*-unmount-drive-sleep-hook /etc/systemd/system-sleep/unmount-drive
  #   EOF
  #   sudo chmod 0440 /etc/sudoers.d/home-manager-sleep-hook
  #
  # After that, every `home-manager switch` re-installs the script
  # only when its contents change (cmp guard keeps it idempotent).
  home.activation.installDriveSleepHook =
    let
      hook = pkgs.writeText "unmount-drive-sleep-hook" ''
        #!/bin/sh
        case "$1" in
          pre)
            /usr/bin/mountpoint -q /home/pthrr/Drive && \
              /usr/bin/fusermount -uz /home/pthrr/Drive
            ;;
        esac
      '';
      dest = "/etc/systemd/system-sleep/unmount-drive";
    in
    lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      if ! /usr/bin/cmp -s ${hook} ${dest} 2>/dev/null; then
        /usr/bin/sudo -n /usr/bin/install -D -m0755 -o root -g root \
          ${hook} ${dest} \
          || echo "warning: could not install ${dest} (missing sudoers rule?)" >&2
      fi
    '';

  # Claude Code owns ~/.claude/settings.json: /model and /effort write their
  # defaults there, and a Nix store symlink would make those saves fail silently.
  # Seed it once with the settings that have no plugin equivalent, then leave it
  # alone — the hooks arrive through the agent-hooks plugin instead.
  home.activation.seedClaudeSettings =
    let
      seed = ../../dotfiles/agents/.agents/claude/settings.seed.json;
      dest = "${config.home.homeDirectory}/.claude/settings.json";
    in
    # After linkGeneration, not writeBoundary: linkGeneration is what removes the
    # previously managed symlink, and it anchors to writeBoundary too. As siblings
    # the order is unspecified, and seeding first would find the old link, skip,
    # and leave no settings.json once linkGeneration deleted it.
    lib.hm.dag.entryAfter [ "linkGeneration" ] ''
      if [ ! -e "${dest}" ] && [ ! -L "${dest}" ]; then
        /usr/bin/install -D -m0644 ${seed} "${dest}"
      fi
    '';

  # Create user desktop entries with nixGL wrappers for Nix-installed GUI apps.
  # The profile entries stay untouched; user entries take precedence by filename.
  home.activation.patchDesktopEntriesForNixGL = lib.hm.dag.entryAfter [ "installPackages" ] (
    nixbitsLib.ts ''
      const fs = require("node:fs");
      const path = require("node:path");

      const home = requireEnv("HOME");

      const sourceDir = path.join(home, ".nix-profile/share/applications");
      const targetDir = path.join(
        process.env.XDG_DATA_HOME || path.join(home, ".local/share"),
        "applications",
      );
      const marker = "# Generated by home-manager activation; edits will be replaced.\n";

      let variant = process.env.NIXGL_VARIANT;
      if (!variant) {
        let gpuInfo = "";
        try {
          gpuInfo = execFileSync("lspci", { encoding: "utf8" });
        } catch {
          // Use the same Intel fallback when lspci is unavailable.
        }
        if (/vga.*intel/i.test(gpuInfo)) variant = "nixGLIntel";
        else if (/vga.*(amd|radeon)/i.test(gpuInfo)) variant = "nixGLAMD";
        else {
          console.error("Could not detect Intel or AMD graphics, defaulting to nixGLIntel");
          variant = "nixGLIntel";
        }
      }
      if (variant !== "nixGLIntel" && variant !== "nixGLAMD") {
        throw new Error("Invalid NIXGL_VARIANT: " + variant);
      }

      function sourceFile(name: string): boolean {
        return fs.statSync(path.join(sourceDir, name), { throwIfNoEntry: false })?.isFile() ?? false;
      }

      function ownedOverride(file: string): boolean {
        const info = fs.lstatSync(file, { throwIfNoEntry: false });
        return info?.isFile() === true && fs.readFileSync(file, "utf8").startsWith(marker);
      }

      fs.mkdirSync(targetDir, { recursive: true });
      for (const name of fs.readdirSync(sourceDir)) {
        if (!name.endsWith(".desktop") || !sourceFile(name)) continue;
        const source = path.join(sourceDir, name);
        const target = path.join(targetDir, name);
        if (fs.lstatSync(target, { throwIfNoEntry: false }) && !ownedOverride(target)) {
          console.error("Skipping personal desktop entry: " + target);
          continue;
        }

        const content = marker + fs.readFileSync(source, "utf8").replace(
          /^Exec=(?:nixGLIntel |nixGLAMD )?/gm,
          "Exec=" + variant + " ",
        );
        writeFileAtomic(target, content, { mode: 0o644 });
      }

      for (const name of fs.readdirSync(targetDir)) {
        if (!name.endsWith(".desktop")) continue;
        const target = path.join(targetDir, name);
        if (ownedOverride(target) && !sourceFile(name)) fs.unlinkSync(target);
      }
    ''
  );

}
