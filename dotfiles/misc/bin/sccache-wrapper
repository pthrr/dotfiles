#!/usr/bin/env bash
set -euo pipefail

S3_HOST="${SCCACHE_S3_HOST:-nwv-srv}"
S3_PORT="${SCCACHE_S3_PORT:-8333}"

# Find the sccache binary even where PATH is minimal (nix build sandboxes
# only carry stdenv tools).
find_sccache() {
    local p
    if p="$(command -v sccache 2>/dev/null)"; then
        printf '%s\n' "$p"
        return 0
    fi
    local -a candidates=(
        /run/current-system/sw/bin/sccache
        /nix/var/nix/profiles/default/bin/sccache
    )
    for p in /nix/var/nix/profiles/per-user/*/profile/bin/sccache; do
        candidates+=("$p")
    done
    for p in "${candidates[@]}"; do
        if [[ -x $p ]]; then
            printf '%s\n' "$p"
            return 0
        fi
    done
    return 1
}

sccache_bin="$(find_sccache)" || {
    echo "sccache: sccache binary not found in PATH or nix profiles" >&2
    exit 127
}

# The dedicated sccache-daemon user service owns the remote-vs-local storage
# decision (it probes nwv-srv at start and a timer restarts it when
# reachability flips). Any client that can see its socket rides it, which is
# what makes remote caching work from inside sandboxes: nix build sandboxes
# have no network at all and claude/opencode sandboxes only pass unix
# sockets, but the daemon runs outside and does all remote traffic. The last
# candidate covers nix build sandboxes, where the host runtime dir is
# bind-mounted but the build user's uid differs.
uds=""
for uds_candidate in \
    "${SCCACHE_SERVER_UDS:-}" \
    "${XDG_RUNTIME_DIR:-}/sccache/sccache.sock" \
    "/run/user/$(id -u)/sccache/sccache.sock" \
    "/run/user/1000/sccache/sccache.sock"; do
    if [[ -n $uds_candidate && -S $uds_candidate ]]; then
        uds="$uds_candidate"
        break
    fi
done

if [[ -n $uds ]]; then
    echo "sccache: Using daemon ($uds)" >&2
    # The daemon holds the storage config. Strip storage vars so a
    # client-spawned fallback daemon (stale socket) starts clean-local
    # instead of inheriting unreachable remote settings.
    exec env -u SCCACHE_DIR -u SCCACHE_CACHE_SIZE -u SCCACHE_NO_DAEMON \
        -u SCCACHE_BUCKET -u SCCACHE_ENDPOINT -u SCCACHE_REGION \
        -u SCCACHE_S3_USE_SSL -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY \
        SCCACHE_SERVER_UDS="$uds" \
        "$sccache_bin" "$@"
fi

probe_remote() {
    timeout 2 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$S3_HOST" "$S3_PORT" 2>/dev/null
}

# Sandboxed environments (nix build sandboxes, claude/codex sandboxes) may
# have no network and sometimes no writable HOME; in that case fall back to
# an isolated no-daemon local cache instead of failing or hanging (blocked
# connects fail instantly with EPERM/ENETUNREACH, so the probe is cheap).
# SCCACHE_SANDBOX overrides detection: 1 forces, 0 disables.
sandboxed=0
if [[ -n "${SCCACHE_SANDBOX:-}" ]]; then
    if [[ "${SCCACHE_SANDBOX}" != 0 ]]; then
        sandboxed=1
    fi
elif [[ -n "${NIX_BUILD_TOP:-}" ]] \
    || [[ "${HOME:-}" == /homeless-shelter ]] \
    || [[ -n "${CLAUDECODE:-}" ]] \
    || [[ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]] \
    || [[ -n "${CODEX_SANDBOX:-}" ]] \
    || [[ -n "${CODEX_SANDBOX_NETWORK_DISABLED:-}" ]]; then
    sandboxed=1
fi

if [[ $sandboxed == 1 ]]; then
    if probe_remote; then
        echo "sccache: Using remote (${S3_HOST}:${S3_PORT})" >&2
        exec env -u SCCACHE_DIR -u SCCACHE_CACHE_SIZE -u SCCACHE_NO_DAEMON \
            SCCACHE_BUCKET=sccache \
            "SCCACHE_ENDPOINT=http://${S3_HOST}:${S3_PORT}" \
            SCCACHE_S3_USE_SSL=false \
            SCCACHE_REGION=us-east-1 \
            AWS_ACCESS_KEY_ID=sccache \
            AWS_SECRET_ACCESS_KEY=sccache \
            "$sccache_bin" "$@"
    fi
    echo "sccache: sandboxed without daemon or network, using isolated local cache" >&2
    cache_dir=""
    try_dir() {
        if [[ -z $cache_dir ]] && mkdir -p "$1" 2>/dev/null && [[ -w $1 ]]; then
            cache_dir="$1"
        fi
    }
    if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
        try_dir "$XDG_CACHE_HOME/sccache"
    fi
    if [[ -n "${HOME:-}" && "${HOME}" != /homeless-shelter ]]; then
        try_dir "$HOME/.cache/sccache"
    fi
    try_dir "${TMPDIR:-/tmp}/sccache"
    if [[ -z $cache_dir ]]; then
        echo "sccache: no writable cache directory found" >&2
        exit 1
    fi
    exec env -u SCCACHE_BUCKET -u SCCACHE_ENDPOINT -u SCCACHE_REGION \
        -u SCCACHE_S3_USE_SSL -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY \
        "SCCACHE_DIR=$cache_dir" SCCACHE_CACHE_SIZE=5G SCCACHE_NO_DAEMON=1 \
        "$sccache_bin" "$@"
fi

if probe_remote; then
    echo "sccache: Using remote (${S3_HOST}:${S3_PORT})" >&2
    sccache_env=(
        -u SCCACHE_DIR
        -u SCCACHE_CACHE_SIZE
        -u SCCACHE_NO_DAEMON
        SCCACHE_BUCKET=sccache
        "SCCACHE_ENDPOINT=http://${S3_HOST}:${S3_PORT}"
        SCCACHE_S3_USE_SSL=false
        SCCACHE_REGION=us-east-1
        AWS_ACCESS_KEY_ID=sccache
        AWS_SECRET_ACCESS_KEY=sccache
    )
else
    echo "sccache: Using local (~/.cache/sccache)" >&2
    cache_dir="$HOME/.cache/sccache"
    sccache_env=(
        -u SCCACHE_BUCKET
        -u SCCACHE_NO_DAEMON
        -u SCCACHE_ENDPOINT
        -u SCCACHE_REGION
        -u SCCACHE_S3_USE_SSL
        -u AWS_ACCESS_KEY_ID
        -u AWS_SECRET_ACCESS_KEY
        "SCCACHE_DIR=$cache_dir"
        SCCACHE_CACHE_SIZE=5G
    )
fi

exec env "${sccache_env[@]}" "$sccache_bin" "$@"
