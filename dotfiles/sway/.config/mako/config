# Mako notification daemon configuration

# Automatically dismiss notifications after 5 seconds (5000 milliseconds)
# Set to 0 to require manual dismissal
default-timeout=5000

# Font
font=JetBrains Mono 11

# Colors (matching Sway grayscale theme)
background-color=#000000
text-color=#909090
border-color=#909090
border-size=2

# Position
anchor=top-right
margin=10

# Size
width=300
height=100

# Layout
padding=10

# Critical urgency: never auto-dismiss, red border
[urgency=critical]
default-timeout=0
border-color=#ff0000

# Battery warnings: never auto-dismiss, red border
[app-name=battery-alertd]
default-timeout=0
border-color=#ff0000
